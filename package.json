{
  "name": "aio-plugin-vibecli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "nuxt build && node scripts/build.mjs",
    "typecheck": "nuxt typecheck",
    "test": "tsx --test test/*.test.ts backend/commands/*.test.ts backend/projects/*.test.ts backend/settings/*.test.ts",
    "test:artifact": "tsx --test test/artifact.e2e.ts",
    "test:browser": "tsx --test test/browser.e2e.ts",
    "test:container": "node --test test/container.e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:artifact"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "acorn": "^8.18.0",
    "codemirror": "^6.0.2",
    "commander": "^14.0.0",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "4.5.2",
    "pg": "^8.16.3",
    "quickjs-emscripten": "^0.31.0",
    "vue": "3.5.42",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "22.15.30",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.5"
  }
}
